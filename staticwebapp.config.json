{
  "trailingSlash": "auto",
  "mimeTypes": {
    ".mp4": "video/mp4",
    ".webm": "video/webm",
    ".glb": "model/gltf-binary",
    ".usdz": "model/vnd.usdz+zip"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' blob: https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self' https://mattresshub.co https://www.mattresshub.co"
  },
  "routes": [
    {
      "route": "/*.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/*.css",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/*.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/products/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/build-your-bed/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/soho/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/room-tour/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/your-space/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/guides/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/zh/guides/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/ms/guides/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/sitemap.xml",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/robots.txt",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ]
}